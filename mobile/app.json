{
  "expo": {
    "name": "Krmeet",
    "slug": "krmeet-mobile",
    "version": "0.1.0",
    "scheme": "krmeet",
    "plugins": [
      [
        "react-native-maps",
        {
          "enableBackgroundLocationUpdates": true
        }
      ]
    ],
    "android": {
      "package": "com.krmeet.app",
      "config": {
        "googleMaps": {
          "apiKey": "TU_API_KEY_DE_GOOGLE_MAPS"
        }
      }
    }
  }
}
